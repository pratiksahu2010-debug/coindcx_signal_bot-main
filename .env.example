# ========== REQUIRED FOR TELEGRAM SIGNALS ==========
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
TELEGRAM_ADMIN_IDS=987654321
# Get your numeric ID from @userinfobot — comma-separate multiple IDs

# ========== DATABASE (optional) ==========
# Local development only. Render production requires PostgreSQL for durable dedup/outbox.
DATABASE_URL=sqlite+aiosqlite:///./coindcx_signal_bot.db
# On Render, set DATABASE_URL to your PostgreSQL connection string:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/coindcx_signals

# ========== COINDCX (public data needs no keys) ==========
COINDCX_API_KEY=
COINDCX_API_SECRET=

# ========== APP ==========
APP_ENV=development
LOG_LEVEL=INFO
SIGNAL_THRESHOLD=7.0
CANDLE_PRIMARY_TF=5m
CANDLE_CONFIRM_TF=15m
CANDLE_CLOSE_GRACE_SECONDS=3
MAX_SIGNAL_AGE_SECONDS=120
NORMAL_SYMBOL_LIMIT=40
MOMENTUM_SYMBOL_LIMIT=80
# Minimum estimated 24h USDT turnover (CoinDCX Futures base volume x last price).
# Candidates below the floor are skipped without changing static allowlist order.
NORMAL_MIN_24H_TURNOVER_USDT=1000000
MOMENTUM_MIN_24H_TURNOVER_USDT=500000
MAX_CANDLES_BUFFER=300
ENABLE_WEBSOCKET=true
ENABLE_NORMAL_ENGINE=true
ENABLE_MOMENTUM_ENGINE=true
MEMORY_WARNING_MB=400

# ========== INDICATOR FILTERS ==========
NORMAL_ADX_MIN=25.0
# Normal Engine only: completed-candle volume / mean of prior 20 completed candles
NORMAL_RVOL_MIN=1.2
# Momentum engine ADX threshold (independent from normal engine)
MOMENTUM_ADX_MIN=18.0

# Conservative combined round-trip Futures fee + slippage allowance (basis points)
FUTURES_ROUND_TRIP_COST_BPS=15.0
# Maximum live Futures top-of-book bid/ask spread accepted for a signal.
# The check runs only for otherwise-qualified immediate entries and retest promotions.
FUTURES_MAX_SPREAD_BPS=20.0
# Optional minimum quote-notional on BOTH sides of top-five Futures book levels (0 disables gate)
FUTURES_MIN_SIDE_DEPTH_USDT=0.0

# ========== SESSION OPENING RANGE BREAKOUT (5m) ==========
# Session clocks follow local time zones and automatically adjust for DST.
ORB_ENABLED=true
ORB_LONDON_ENABLED=true
ORB_NEW_YORK_ENABLED=true
ORB_MIN_RVOL=1.30
ORB_MAX_EXTENSION_ATR=0.80
ORB_ACTIVE_MINUTES=180

# Signal-only safety is enforced in config.py; no order execution is available.
SIGNAL_ONLY=true
ORDERS_ENABLED=false
